# Copy this to .env and fill in your values.
# The app works without any of these -- each feature gracefully degrades.

# ── LLM Incident Summaries (Anthropic) ──────────────────────────────────────
# Without this, summaries use the offline template fallback.
ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram Bot Alerts ──────────────────────────────────────────────────────
# Bot created at t.me/NIDAII_bot via BotFather.
# Without TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID, notifications are silently skipped.
TELEGRAM_BOT_TOKEN=8559679492:AAGMNiL_1U89PJajzSaIdywAfg73VvD_01g

# How to get your CHAT_ID:
#   1. Open Telegram and start a chat with @NIDAII_bot  (send /start)
#   2. Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   3. Copy the "id" value from the "chat" object
TELEGRAM_CHAT_ID=

# Only send Telegram notifications for alerts with risk score >= this value.
# Default: 70.  Set to 0 to notify on every alert (noisy).
TELEGRAM_MIN_RISK=70

# Set to "false" to temporarily disable Telegram without removing the token.
TELEGRAM_ENABLED=true
